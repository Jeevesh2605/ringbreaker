# Copy to .env and fill in. .env is gitignored; never commit real keys.

# FalkorDB connection (docker-compose exposes these locally)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=ring

# LLM via Groq (free tier works). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
MODEL=openai/gpt-oss-120b

# API server (used from Day 3)
PORT=8080
ADMIN_SECRET=change-me
